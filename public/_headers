/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: display-capture=(), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  X-Robots-Tag: noindex, noarchive

/private/*
  Cache-Control: private, no-store
  Content-Disposition: attachment

/admin/*
  Cache-Control: private, no-store
